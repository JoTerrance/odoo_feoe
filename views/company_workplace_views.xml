<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para centros de trabajo -->
    <record id="view_company_workplace_form" model="ir.ui.view">
        <field name="name">company.workplace.form</field>
        <field name="model">company.workplace</field>
        <field name="arch" type="xml">
            <form string="Centro de Trabajo">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="Nombre del centro de trabajo"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Dirección">
                            <group>
                                <group>
                                    <field name="street" placeholder="Calle y número"/>
                                    <field name="city" placeholder="Ciudad"/>
                                </group>
                                <group>
                                    <field name="state" placeholder="Provincia"/>
                                    <field name="zip" placeholder="Código postal"/>
                                    <field name="country"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Horarios">
                            <group>
                                <group>
                                    <field name="company_schedule" placeholder="Ej: L-V 8:00-17:00"/>
                                </group>
                                <group>
                                    <field name="student_schedule" placeholder="Ej: L-V 8:00-14:00"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Tutores Asignados">
                            <field name="tutor_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"/>
                        </page>
                        
                        <page string="Observaciones">
                            <field name="observations" placeholder="Observaciones adicionales sobre este centro..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista de árbol para centros de trabajo -->
    <record id="view_company_workplace_tree" model="ir.ui.view">
        <field name="name">company.workplace.tree</field>
        <field name="model">company.workplace</field>
        <field name="arch" type="xml">
            <tree string="Centros de Trabajo" editable="bottom" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="city"/>
                <field name="phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="tutor_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <!-- Vista de búsqueda para centros de trabajo -->
    <record id="view_company_workplace_search" model="ir.ui.view">
        <field name="name">company.workplace.search</field>
        <field name="model">company.workplace</field>
        <field name="arch" type="xml">
            <search string="Buscar Centros de Trabajo">
                <field name="name"/>
                <field name="company_id"/>
                <field name="city"/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empresa" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Ciudad" name="group_city" context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para centros de trabajo -->
    <record id="action_company_workplace" model="ir.actions.act_window">
        <field name="name">Centros de Trabajo</field>
        <field name="res_model">company.workplace</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo centro de trabajo
            </p>
            <p>
                Registra los diferentes centros de trabajo de las empresas.
            </p>
        </field>
    </record>
</odoo>
