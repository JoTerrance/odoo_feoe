<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
    VISTA ADICIONAL PARA INFORMACIÓN FCT
    
    Este archivo contiene la pestaña de "Información FCT" que debe añadirse
    DESPUÉS de actualizar el módulo por primera vez.
    
    INSTRUCCIONES:
    1. Actualiza el módulo en Odoo (Apps > Gestión de Empresas FEOE > Actualizar)
    2. Añade este archivo a __manifest__.py en la sección 'data':
       'views/company_fct_info_view.xml',
    3. Vuelve a actualizar el módulo
    
    Esta vista se añadirá automáticamente a la vista del formulario de empresas.
    -->
    
    <record id="view_company_info_form_fct_inherited" model="ir.ui.view">
        <field name="name">company.info.form.fct</field>
        <field name="model">company.info</field>
        <field name="inherit_id" ref="view_company_info_form"/>
        <field name="arch" type="xml">
            <!-- Añadir la pestaña de Información FCT después de "Descripción y Notas" -->
            <xpath expr="//notebook" position="inside">
                <page string="Información FCT" attrs="{'invisible': [('representative', '=', False), ('tutor_fct', '=', False), ('activities', '=', False)]}">
                    <group string="Responsables FCT">
                        <group>
                            <field name="representative"/>
                            <field name="representative_nif"/>
                        </group>
                        <group>
                            <field name="tutor_fct"/>
                            <field name="tutor_fct_nif"/>
                        </group>
                    </group>
                    <group string="Recursos Humanos">
                        <group>
                            <field name="rrhh_contact"/>
                            <field name="rrhh_email" widget="email"/>
                        </group>
                        <group>
                            <field name="rrhh_phone" widget="phone"/>
                        </group>
                    </group>
                    <group string="Horarios">
                        <group>
                            <field name="company_schedule" placeholder="Ej: L-V 8:00-17:00"/>
                        </group>
                        <group>
                            <field name="student_schedule" placeholder="Ej: L-V 8:00-14:00"/>
                        </group>
                    </group>
                    <group string="Actividades y Observaciones">
                        <field name="activities" placeholder="Descripción de actividades que realizará el alumno..." nolabel="1"/>
                    </group>
                    <group string="Observaciones" attrs="{'invisible': [('observations', '=', False)]}">
                        <field name="observations" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
