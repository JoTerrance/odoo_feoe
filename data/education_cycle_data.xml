<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Ciclos Formativos de Grado Superior -->
        <record id="cycle_dam" model="education.cycle">
            <field name="name">Desarrollo de Aplicaciones Multiplataforma</field>
            <field name="code">DAM</field>
            <field name="level">gs</field>
            <field name="sequence">10</field>
            <field name="description">Grado Superior en Desarrollo de Aplicaciones Multiplataforma</field>
        </record>

        <record id="cycle_asir" model="education.cycle">
            <field name="name">Administración de Sistemas Informáticos en Red</field>
