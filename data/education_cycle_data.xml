        </record>

        <!-- Ciclo Formativo de Grado Medio -->
        <record id="cycle_smr" model="education.cycle">
            <field name="name">Sistemas Microinformáticos y Redes</field>
            <field name="code">SMR</field>
            <field name="level">gm</field>
            <field name="sequence">30</field>
            <field name="description">Grado Medio en Sistemas Microinformáticos y Redes</field>
        </record>
